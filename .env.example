# Copy to .env and fill in to enable the optional autofill features.
# .env is git-ignored. These are read server-side only and never reach the
# browser bundle.
#
# NONE OF THIS IS REQUIRED. With an empty file you still get: address
# autocomplete (free geocoders), county assessor records — beds/baths/sqft,
# year built, annual tax, last sale date — where a county adapter exists
# (server/publicRecords.js), listing paste (local regex), the mortgage
# calculator, tax + insurance estimates, and current value indexed off the
# purchase price (src/lib/hpi.js). The keys below buy per-address AVM value and
# rent estimates nationwide, not the feature itself.

# Rentcast (https://app.rentcast.io) — "Look up property": value, rent estimate,
# last sale, beds/baths/sqft. Free tier ≈ 50 API calls/month; each lookup uses
# ~3 — 2 when the county assessor already answered for the record fields.
RENTCAST_API_KEY=

# Anthropic (https://console.anthropic.com) — "Paste a listing": Claude extracts
# price / rent / tax / HOA / beds-baths from listing text you paste in.
ANTHROPIC_API_KEY=

# Optional — model for the listing extractor. Default: claude-opus-5.
# claude-haiku-4-5 is ~5x cheaper and fine for this simple extraction.
LISTING_MODEL=claude-opus-5

# Optional — a second property source: an unofficial Zillow API on RapidAPI.
# Used to backfill value / rent / beds when Rentcast comes up short. Leave blank
# to skip. HOST is the "X-RapidAPI-Host" value from the API's RapidAPI page.
RAPIDAPI_KEY=
RAPIDAPI_ZILLOW_HOST=

# Optional — Redfin's UNOFFICIAL internal API (no key). Ports the calls from
# github.com/reteps/redfin. Undocumented, against Redfin's ToS, may break or
# rate-limit; personal low-volume use only. Set to 1 to opt in.
REDFIN_ENABLED=

# Optional last-resort fallback: US Census ACS area medians fill value/rent when
# nothing better is available (tagged "area median" in the UI). Free instant key
# at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ---------------------------------------------------------------------------
# Server-side persistence, so a property list survives redeploys and follows
# its owner across devices. Set ONE of these; first configured wins. With none
# of them, the app falls back to the browser's localStorage (per-browser).
#
# A) Postgres — THE ONE TO USE if more than one person will log in. Rows are
#    scoped to each account's Firebase uid, so every user sees only their own
#    portfolio. Free at neon.tech; on Vercel, attach a Neon/Postgres store from
#    Storage and this gets injected for you.
DATABASE_URL=
#
# B) KV / Redis over REST — works on serverless (Upstash, Vercel KV).
#    Vercel KV injects these two automatically when you attach a KV store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# C) A JSON file — for a host with a persistent disk (Railway/Render/Fly/VPS)
#    or local use. Use an absolute path outside the repo.
DATA_FILE=
#
# B and C predate multi-user: they namespace by account so two people won't
# overwrite each other, but they were built for a single user. Use A for
# anything you publish.

# ---------------------------------------------------------------------------
# Login gate (Firebase email/password). Sign-up sends a verification email —
# that's the only setup step, no authenticator app. Login is just email +
# password. Set the FIREBASE_* + SESSION_SECRET vars to turn it on; leave them
# blank for an open build (local dev).

# Client Firebase web config — safe to expose (Firebase console → Project
# settings → "Your apps"). These MUST be prefixed VITE_ to reach the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side (no VITE_ prefix — never sent to the browser):
FIREBASE_PROJECT_ID=       # same value as VITE_FIREBASE_PROJECT_ID
SESSION_SECRET=            # any long random string (openssl rand -hex 32)

# Signup is open: anyone who verifies their email can create an account and
# gets their own private ledger, scoped to their Firebase uid.

# LOCAL TESTING ONLY — never set in production. When this is set (with
# SESSION_SECRET, and WITHOUT the Firebase vars above) the login gate turns on
# in "dev mode": one plain password, no Firebase project needed.
AUTH_DEV_PASSWORD=

