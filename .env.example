# Copy to .env and fill in to enable the optional autofill features.
# .env is git-ignored. These are read server-side only and never reach the
# browser bundle.

# Rentcast (https://app.rentcast.io) — "Look up property": value, rent estimate,
# last sale, beds/baths/sqft. Free tier ≈ 50 API calls/month; each lookup uses ~3.
RENTCAST_API_KEY=

# Anthropic (https://console.anthropic.com) — "Paste a listing": Claude extracts
# price / rent / tax / HOA / beds-baths from listing text you paste in.
ANTHROPIC_API_KEY=

# Optional — model for the listing extractor. Default: claude-opus-5.
# claude-haiku-4-5 is ~5x cheaper and fine for this simple extraction.
LISTING_MODEL=claude-opus-5

# Optional — a second property source: an unofficial Zillow API on RapidAPI.
# Used to backfill value / rent / beds when Rentcast comes up short. Leave blank
# to skip. HOST is the "X-RapidAPI-Host" value from the API's RapidAPI page.
RAPIDAPI_KEY=
RAPIDAPI_ZILLOW_HOST=

# Optional — Redfin's UNOFFICIAL internal API (no key). Ports the calls from
# github.com/reteps/redfin. Undocumented, against Redfin's ToS, may break or
# rate-limit; personal low-volume use only. Set to 1 to opt in.
REDFIN_ENABLED=

# Optional last-resort fallback: US Census ACS area medians fill value/rent when
# nothing better is available (tagged "area median" in the UI). Free instant key
# at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ---------------------------------------------------------------------------
# Optional: server-side persistence so your property list survives redeploys
# and follows you across devices. Set ONE of these. Without either, the app
# keeps using the browser's localStorage (per-browser, per-domain).
#
# A) KV / Redis over REST — works on serverless (Upstash, Vercel KV).
#    Vercel KV injects these two automatically when you attach a KV store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# B) A JSON file — for a host with a persistent disk (Railway/Render/Fly/VPS)
#    or local use. Use an absolute path outside the repo.
DATA_FILE=

# ---------------------------------------------------------------------------
# Optional: login gate (Firebase email/password + an authenticator-app code).
# Set ALL FOUR server vars below to turn it on; leave them blank for an open
# build (local dev). Create the client's account in the Firebase console
# (Authentication → Users → Add user). No sign-up page.

# Client Firebase web config — safe to expose (Firebase console → Project
# settings → "Your apps"). These MUST be prefixed VITE_ to reach the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side (no VITE_ prefix — never sent to the browser):
FIREBASE_PROJECT_ID=       # same value as VITE_FIREBASE_PROJECT_ID
ALLOWED_EMAIL=             # the one account allowed in (lowercase)
TOTP_SECRET=               # run:  npm run totp:setup -- you@example.com
SESSION_SECRET=            # any long random string (openssl rand -hex 32)

