# Copy to .env and fill in to enable the optional autofill features.
# .env is git-ignored. These are read server-side only and never reach the
# browser bundle.

# Rentcast (https://app.rentcast.io) — "Look up property": value, rent estimate,
# last sale, beds/baths/sqft. Free tier ≈ 50 API calls/month; each lookup uses ~3.
RENTCAST_API_KEY=

# Anthropic (https://console.anthropic.com) — "Paste a listing": Claude extracts
# price / rent / tax / HOA / beds-baths from listing text you paste in.
ANTHROPIC_API_KEY=

# Optional — model for the listing extractor. Default: claude-opus-5.
# claude-haiku-4-5 is ~5x cheaper and fine for this simple extraction.
LISTING_MODEL=claude-opus-5

# Optional — a second property source: an unofficial Zillow API on RapidAPI.
# Used to backfill value / rent / beds when Rentcast comes up short. Leave blank
# to skip. HOST is the "X-RapidAPI-Host" value from the API's RapidAPI page.
RAPIDAPI_KEY=
RAPIDAPI_ZILLOW_HOST=

# Optional last-resort fallback: US Census ACS area medians fill value/rent when
# nothing better is available (tagged "area median" in the UI). Free instant key
# at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

